<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Devalente.Shared -->
    <PackageVersion Include="Devalente.Shared.Results" Version="0.2.0" />
    <PackageVersion Include="Devalente.Shared.Cqrs.Abstractions" Version="0.2.0" />
    <PackageVersion Include="Devalente.Shared.Cqrs" Version="0.2.0" />
    <PackageVersion Include="Devalente.Shared.Validation.FluentValidation" Version="0.2.0" />
    <PackageVersion Include="Devalente.Shared.AspNetCore.Mvc" Version="0.2.0" />
    <PackageVersion Include="Devalente.Shared.AspNetCore.Security" Version="0.2.0" />
    <PackageVersion Include="Devalente.Shared.EntityFrameworkCore" Version="0.2.0" />
    <PackageVersion Include="Devalente.Shared.OpenApi.NSwag" Version="0.2.0" />

    <!-- EF Core: provider-neutral, provider, and tooling -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />

    <!-- Test-only: builds a minimal DI container exercising the real Devalente mediator and
         EF Core transaction pipeline outside the full ASP.NET Core host. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />

    <!-- Third-party -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
