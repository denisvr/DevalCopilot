{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revisionResponses",
    "executionReport"
  ],
  "properties": {
    "revisionResponses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingMessageId",
          "disposition",
          "evidence",
          "resultingSourceChanges"
        ],
        "properties": {
          "findingMessageId": {
            "type": "string",
            "format": "uuid"
          },
          "disposition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 900
          },
          "resultingSourceChanges": {
            "type": "string",
            "minLength": 1,
            "maxLength": 900
          }
        }
      }
    },
    "executionReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "changedRelativePaths",
        "implementationNotes",
        "unexpectedDiscoveries",
        "remainingRisks",
        "recommendedVerification"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "changedRelativePaths": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "implementationNotes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 900
        },
        "unexpectedDiscoveries": {
          "type": "string",
          "minLength": 0,
          "maxLength": 900
        },
        "remainingRisks": {
          "type": "string",
          "minLength": 0,
          "maxLength": 900
        },
        "recommendedVerification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 900
        }
      }
    }
  }
}
