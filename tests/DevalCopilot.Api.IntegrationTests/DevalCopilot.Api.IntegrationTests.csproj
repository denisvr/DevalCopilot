<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- SkipNSwag: this reference must not trigger a client regeneration during a test build. -->
    <ProjectReference Include="..\..\src\backend\DevalCopilot.Api\DevalCopilot.Api.csproj">
      <AdditionalProperties>SkipNSwag=True</AdditionalProperties>
    </ProjectReference>
    <!-- A deterministic test-double executable, not a shipped product artifact: its build
         output (including the native apphost) is copied alongside this test project's own
         output so the hosted-supervisor test can launch it as a real child process. -->
    <ProjectReference Include="..\DevalCopilot.Infrastructure.IntegrationTests\Fixtures\ProcessExecutionFixture\ProcessExecutionFixture.csproj" />
  </ItemGroup>
</Project>
